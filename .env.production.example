# Custom images must be immutable name@sha256 references.
RUNTIME_AGENT_IMAGE=
SESSION_MANAGER_IMAGE=
RETRO_SESSION_IMAGE=
ROMM_IMAGE=

# Public endpoints and TLS.
PUBLIC_HOSTNAME=
AUTH_HOSTNAME=
TURN_HOST=
TURN_REALM=
TLS_CERT_FILE=
TLS_KEY_FILE=
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200

# Absolute host paths. The initializer fills repository-local defaults.
ROM_ROOT=
USER_DATA_ROOT=
SAVE_DATA_ROOT=
ROUTE_CONFIG_ROOT=
METRICS_TARGET_ROOT=

# SMTP and initial administrator identity.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM=
ADMIN_EMAIL=

# Generated by initialize.ps1. Do not reuse example values.
SERVICE_TOKEN=
ORCHESTRATION_SECRET=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_POSTGRES_PASSWORD=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=
OIDC_CLIENT_ID=retrobrowser-romm
OIDC_CLIENT_SECRET=
ROMM_DB_PASSWORD=
ROMM_DB_ROOT_PASSWORD=
ROMM_AUTH_SECRET_KEY=
TURN_SHARED_SECRET=
TURN_REST_API_KEY=
GRAFANA_ADMIN_PASSWORD=

# Capacity and runtime policy.
GPU_PROFILES=cpu
DEFAULT_GPU_PROFILE=cpu
MANAGE_USER_DATA_PERMISSIONS=true
RUNTIME_CAPACITY=8
SESSION_CAPACITY=4
PER_USER_RUNTIME_CAPACITY=1
RUNTIME_MEMORY_BYTES=4294967296
RUNTIME_NANO_CPUS=2000000000
RUNTIME_PIDS_LIMIT=1024
MAX_SESSION_SECONDS=14400
LOBBY_LEASE_SECONDS=120
IDLE_TIMEOUT_SECONDS=45
CLEANUP_INTERVAL_SECONDS=10
OBSERVABILITY_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
PROMETHEUS_RETENTION=15d
