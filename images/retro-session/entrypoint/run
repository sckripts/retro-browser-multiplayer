#!/bin/bash
set -euo pipefail

readonly RUNTIME_SPEC_PATH=/run/retro-session/runtime-spec.json
readonly STREAM_SUBFOLDER="${SELKIES_SUBFOLDER:?SELKIES_SUBFOLDER is required}"
readonly COMMAND_PIPE=/tmp/retroarch-command

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-ubuntu}"
until [ -f "${XDG_RUNTIME_DIR}/container-env" ]; do sleep 0.5; done
# shellcheck disable=SC1091 -- generated by the pinned Selkies entrypoint.
. "${XDG_RUNTIME_DIR}/container-env"

export DISPLAY="${DISPLAY:-:20}"
until [ -S "/tmp/.X11-unix/X${DISPLAY#*:}" ]; do sleep 0.5; done
until [ -S "${PULSE_RUNTIME_PATH:-${XDG_RUNTIME_DIR}/pulse}/native" ]; do sleep 0.5; done
until python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080${STREAM_SUBFOLDER}/api/health', timeout=2)" >/dev/null 2>&1; do
  sleep 0.5
done

if ! xrandr --query | grep -Fq "1280x720_60.00"; then
  xrandr --newmode "1280x720_60.00" 74.50 1280 1344 1472 1664 720 723 728 748 -hsync +vsync
  xrandr --addmode screen "1280x720_60.00"
fi
xrandr --output screen --mode "1280x720_60.00"

if [ ! -f "${RUNTIME_SPEC_PATH}" ]; then
  echo "retro-session: RuntimeSpec is not mounted at ${RUNTIME_SPEC_PATH}" >&2
  exit 64
fi

if [ -e "${COMMAND_PIPE}" ] && [ ! -p "${COMMAND_PIPE}" ]; then
  echo "retro-session: refusing non-FIFO command path ${COMMAND_PIPE}" >&2
  exit 64
fi
if [ ! -p "${COMMAND_PIPE}" ]; then
  mkfifo -m 0600 "${COMMAND_PIPE}"
fi

exec python3 -m session_entrypoint <"${COMMAND_PIPE}"
